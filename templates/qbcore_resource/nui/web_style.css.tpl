* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: transparent;
}

.app {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hidden {
  display: none;
}

.card {
  min-width: 320px;
  padding: 20px;
  border-radius: 16px;
  background: rgba(20, 20, 20, 0.92);
  color: #fff;
}
